<div class="mt-8">
  <% if units.any? %>
    <div class="flex flex-wrap gap-6">
      <% units.each do |unit| %>
        <% model_name = unit.type.downcase %>

        <% partial =
           case unit.type
           when "Activity"
             "activities/activity"
           when "Task"
             "tasks/task"
           when "Comment"
             "comments/comment"
           else
             raise "Invalid model type: #{unit.type}"
           end
        %>
        <%= render partial: partial, locals: { model_name.to_sym => unit } %>
      <% end %>
    </div>
  <% else %>
    <em class="text-muted">No hay entradas</em>
  <% end %>
</div>