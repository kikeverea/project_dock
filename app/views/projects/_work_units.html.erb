<% units = @project.work_units.kept %>

<div id="work-units" class="mt-8">
  <% if units.any? %>
    <div class="flex flex-wrap gap-6">
      <% units.each do |unit| %>
        <% model_name = unit.type.downcase %>

        <% case unit.type
           when "Activity"
             partial = "activities/activity"
           when "Task"
             next if unit.parent_unit_id
             partial = "tasks/task"
           when "Comment"
             next if unit.parent_unit_id
             partial = "comments/comment"
           else
             raise "Invalid model type: #{unit.type}"
           end
        %>

        <%= render partial: partial, locals: { model_name.to_sym => unit } %>
      <% end %>
    </div>
  <% else %>
    <em class="text-muted">No hay entradas</em>
  <% end %>
</div>