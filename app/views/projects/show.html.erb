<% content_for :title, breadcrumbs(Project, { fallback: projects_path }) %>

<div class="min-w-0 mb-6 flex flex-col lg:flex-row gap-4 justify-between items-start">
  <div>
    <%= link_to @project do %>
      <h1 class="text-3xl font-semibold tracking-tight text-gray-900">
        <%= @project.name %>
      </h1>
    <% end %>

    <div class="mt-1 text-sm text-gray-500">
      <span>Creado <%= @project.created_at.strftime("%d-%m-%Y") %></span>
    </div>
  </div>

  <!-- Client -->
  <div>
    <%= link_to  @project.client, class: "btn outline-primary" do %>
      Ver cliente <i class="fas fa-arrow-right ms-2"></i>
    <% end %>
  </div>
</div>
<div class="flex gap-6 itzems-center">

  <!-- Model diagram -->
  <%= render "projects/config/config_attr",
    attribute: :erd_url,
    image_url: asset_path("drawio_logo.svg"),
    label: "Modelos"
  %>

  <!-- Project scope -->
  <%= render "projects/config/config_attr",
    attribute: :project_scope,
    file_attribute: :file,
    icon: "fa-solid fa-file-lines text-primary",
    label: "Alcance"
  %>

  <%= link_to project_documents_path(@project) do %>
    <%= render "components/tile", label: "Docs", icon: "fa-solid fa-folder-tree text-yellow-500" %>
  <% end %>

  <%= link_to config_project_path(@project, config_attr: :hours), data: { turbo_stream: true } do %>
    <div class="card hover-elevate-up rounded-s-full rounded-e-full group">
      <div class="flex items-center gap-4 relative">
        <span class="font-semibold"><%= @project.used_time || 0 %> / <%= @project.allocated_time %></span>
        <%= image_tag asset_path("clockify_logo.png"), class: "
          w-[50px] h-[50px] rounded-full
          group-hover:rotate-360 group-hover:opacity-0 transition-all"
        %>
        <i class="
          fa-solid fa-gear text-6xl text-[#05A9F4]
          opacity-0 absolute right-1 top-0 bottom-0
          group-hover:rotate-360 group-hover:opacity-100 transition-all"
        ></i>
      </div>
    </div>
  <% end %>
</div>

<%= render "projects/work_units" %>

<div class="fixed bottom-20 end-16 rounded-full w-[65px] h-[65px] bg-green-400 cursor-pointer group">
  <% transition_class = "opacity-0 group-hover:opacity-100 transition-opacity duration-350" %>
  <% style_class = "bg-gray-800 text-white text-sm rounded-full px-4 py-1.5 hover:bg-green-400" %>

  <div class="absolute bottom-full end-1/2 translate-x-1/2 mb-4 flex flex-col items-end gap-3 whitespace-nowrap">
    <%= link_to "Nueva tarea", new_project_task_path(@project), class: "#{transition_class} #{style_class}", data: { turbo_stream: true }%>
    <%= link_to "Nueva actividad", new_project_activity_path(@project), class: "#{transition_class} #{style_class}", data: { turbo_stream: true }%>
    <%= link_to "Nuevo comentario", new_project_comment_path(@project), class: "#{transition_class} #{style_class}", data: { turbo_stream: true }%>
  </div>
  <i class="
    fas fa-plus text-3xl text-white absolute top-1/2 start-1/2 -translate-x-1/2 -translate-y-1/2
    origin-center group-hover:rotate-360 transition-transform duration-450"
  ></i>
</div>

<%= render "components/turbo_modal", channel: :task, size: "md", title: "Tarea" %>
<%= render "components/turbo_modal", channel: :comment, size: "lg", title: "Comentario" %>
<%= render "components/turbo_modal", channel: :activity, size: "md", title: "Actividad" %>
<%= render "components/turbo_modal", channel: :config, size: "sm", title: "Configuración proyecto" %>
