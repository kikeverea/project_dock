<% content_for :title, @project.name %>
<% show_panel = params[:panel]&.to_sym || :activities %>

<div class="flex gap-6 items-center">

  <!-- Model diagram -->
  <%= render "projects/config/config_attr",
    attribute: :erd_url,
    image_url: asset_path("drawio_logo.svg"),
    label: "Modelos"
  %>

  <!-- Project scope -->
  <%= render "projects/config/config_attr",
    attribute: :project_scope,
    file_attribute: :file,
    icon: "fa-solid fa-file-lines text-primary",
    label: "Alcance"
  %>

  <!-- Hours -->
  <%= link_to config_attr_project_path(@project, config_attr: :hours), data: { turbo_stream: true } do %>
    <div class="card hover-elevate-up rounded-s-full rounded-e-full group">
      <div class="flex items-center gap-4 relative">
        <span class="font-semibold"><%= @project.used_time || 0 %> / <%= @project.allocated_time %></span>
        <%= image_tag asset_path("clockify_logo.png"), class: "
          w-[50px] h-[50px] rounded-full
          group-hover:rotate-360 group-hover:opacity-0 transition-all"
        %>
        <i class="
          fa-solid fa-gear text-6xl text-[#05A9F4]
          opacity-0 absolute right-1 top-0 bottom-0
          group-hover:rotate-360 group-hover:opacity-100 transition-all"
        ></i>
      </div>
    </div>
  <% end %>
</div>

<% if show_panel == :activities %>
  <%= render "projects/panel", panel: show_panel, items: @project.activities, item_partial: "activities/activity" %>
<% else %>
  <%= render "projects/panel", panel: show_panel, items: @project.tasks, item_partial: "tasks/task" %>
<% end %>

<%= render "components/turbo_modal", channel: :config, size: "sm", title: "Configuración proyecto" %>
<%= render "components/turbo_modal", channel: :activity, size: "md", title: "Actividad" %>
<%= render "components/turbo_modal", channel: :task, size: "md", title: "Tarea" %>
