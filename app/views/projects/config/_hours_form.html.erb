<% project ||= @project %>

<%= modal_outlet(:config) do %>
  <%= render "components/error_banner", item: project %>

  <%= form_with model: project do |form| %>
    <%= render "components/form_field",
      attribute: :allocated_time,
      type: :number_field,
      item: project,
      form: form,
      placeholder: "Horas",
      icon: "fa-solid fa-clock",
      classes: "flex-col items-start gap-0",
      field_container_class: "w-full"
    %>

    <%= render "components/form_field",
      attribute: :used_time,
      type: :number_field,
      item: project,
      form: form,
      placeholder: "Horas",
      icon: "fa-solid fa-clock",
      classes: "flex-col items-start gap-0",
      field_container_class: "w-full"
    %>

    <%= form.button class: "btn btn-success w-full" do %>
      <i class="fa-solid fa-gear text-sm me-2"></i> Guardar configuración
    <% end %>
  <% end %>
<% end %>