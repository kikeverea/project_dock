<div class="mt-8">
  <% if items.kept.any? %>
    <div class="flex flex-wrap gap-6">
      <% items.each do |item| %>
        <% model_type = item.type.downcase %>
        <% partial =
           case item.type
           when "Activity"
             "activities/activity"
           when "Task"
             "tasks/task"
           when "Comment"
             "comments/comment"
           else
             raise "Invalid model type: #{item.type}"
           end
        %>
        <%= render partial: partial, locals: { model_type.to_sym => item } %>
      <% end %>
    </div>
  <% else %>
    <em class="text-muted">No hay entradas</em>
  <% end %>
</div>