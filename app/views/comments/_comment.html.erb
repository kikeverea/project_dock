<% comment ||= @comment %>
<% reply_to ||= @reply_to %>
<% replies = comment.replies.includes(:parent_comment) %>
<% has_replies ||= replies.any? %>
<% edit ||= false %>

<div
  id="comment-<%= comment.id %>"
  class="<%= "w-[450px]" if @project %>"
  data-search-target="searchItem"
  data-id="<%= comment.id %>"
  data-search-value="<%= comment.attributes.slice("content").transform_values { |v| strip_tags(v) }.to_json %>"
>
  <div class="flex gap-3">
    <!-- Avatar + vertical connecting line to replies -->
    <% unless edit || @project %>
      <div class="flex flex-col items-center">
        <div class="
          w-9 h-9 rounded-full mt-2
          bg-sky-100 text-sky-700 font-bold text-sm
          flex items-center justify-center shrink-0 select-none"
        >
          <%= comment.created_by.initials %>
        </div>
        <% if has_replies %>
          <div class="w-0.5 bg-gray-200 flex-1 mt-1.5 min-h-4 rounded-full"></div>
        <% end %>
      </div>
    <% end %>

    <!-- Comment -->
    <div class="flex-1 min-w-0 pb-3">
      <% if edit %>
        <%= render "comments/form" %>
      <% else %>
        <%= @project ?
          render("comments/comment_link", comment: comment) :
          render("comments/comment_content", comment: comment)
        %>

        <!-- Actions -->
        <% unless @project %>
          <div class="flex items-center gap-4 mt-1.5 px-1">
            <%= link_to new_comment_reply_path(comment),
              class: "text-gray-400 hover:text-sky-600 transition-colors",
              data: { turbo_stream: true } do %>
              <i class="fa-solid fa-reply text-[10px]"></i>  <span class="text-sm">Responder</span>
            <% end %>
            <%= link_to comment_form_path(comment),
              class: "text-sm text-gray-400 hover:text-sky-600 transition-colors",
              data: { turbo_stream: true } do %>
              Editar
            <% end %>
            <%= render "components/delete_button",
              delete_path: delete_comment_path(comment),
              label: "Eliminar",
              model: "comentario",
              classes: "text-sm text-gray-400 hover:text-red-500 transition-colors",
              hide_icon: true
            %>
          </div>
        <% end %>
      <% end %>

      <!-- Nested replies -->
      <% if has_replies && !@project %>
        <div class="mt-3 space-y-1">
          <% comment.replies.order(:created_at).each do |reply| %>
            <%= render "comments/comment", comment: reply %>
            <% if reply_to == reply %>
              <%= render "comments/form" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
