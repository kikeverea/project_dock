<div class="bg-gray-50 rounded-xl border border-gray-100 px-4 py-3">
  <div class="flex items-baseline gap-2 flex-wrap">
    <span class="font-semibold text-gray-900">
      <%= comment.created_by&.full_name %>
    </span>
    <span class="text-sm ms-1 text-gray-500">
      <%= comment.created_at.strftime("%-d %b %Y · %H:%M") %>
    </span>
  </div>
  <div class="mt-1.5 text-gray-700 quill-content">
    <%= comment.content.html_safe %>
  </div>
</div>