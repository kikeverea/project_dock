<% interaction ||= Interaction.new %>
<% edit = interaction.persisted? %>

<div data-controller="resize-area" data-resize-area-min-height-value="100">
  <%= form_with scope: interaction,
    url: action, method: edit ? :put : :post do |form|
  %>
    <%= form.hidden_field :trip_id, value: @trip&.id %>
    <%= form.hidden_field :phase_id, value: @phase&.id %>

    <%= content_tag :div,
      class: "position-relative",
      data: { controller: "quill", quill_content_value: interaction.text } do
    %>
      <%= content_tag :div, nil, data: { quill_target: "quill" } %>
      <%= form.hidden_field :text, data: { quill_target: "value"} %>
      <div class="resize-anchor" data-resize-area-target="dragAnchor">
        <i class="fa-solid fa-minus fs-3 text-gray-600"></i>
        <i class="fa-solid fa-minus fs-6 text-gray-600"></i>
      </div>
    <% end %>

    <%= form.submit edit ? "Guardar" : "Añadir", class: "btn btn-sm btn-success mt-6" %>

    <% if edit %>
      <%= link_to "Cancelar",
        cancel_interaction_edit_path(interaction),
        type: "button",
        class: "btn btn-sm btn-color-muted btn-active-color-success mt-6",
        data: { turbo_prefetch: false, turbo_stream: true }
      %>
    <% end %>
  <% end %>
</div>