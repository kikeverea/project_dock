<% icon ||= "fa-solid fa-trash" %>
<% hide_icon ||= false %>
<% label ||= "Eliminar" %>
<% item_name ||= nil %>
<% model ||= "" %>
<% model_gender ||= "" %>
<% no_padding ||= false %>
<% muted ||= false %>
<% classes ||= "btn btn-flush btn-color-#{muted ? "muted" : "danger"} #{"btn-active-color-danger" if muted} #{"px-2" unless no_padding}" %>
<% icon_size ||= "fs-5" %>
<% as_link ||= false %>
<% simple_tooltip ||= false %>
<% show_text ||= hide_icon %>
<% action_name ||= nil %>
<% reversible_message ||= nil %>
<% tooltip ||= (simple_tooltip ? "Eliminar" :" Eliminar #{item_name || model}") unless hide_icon %>

<% data =  {
  bs_dismiss: "click",
  controller: "delete-button",
  turbo_method: :delete,
  delete_button_model_value: model,
  delete_button_model_gender_value: model_gender,
  delete_button_item_name_value: item_name,
  delete_button_action_name_value: action_name,
  delete_button_show_tooltip_value: !show_text,
  delete_button_reversible_message_value: reversible_message }
%>

<% content = capture do %>
  <% unless hide_icon %>
    <i class="<%= icon %> <%= icon_size %>"></i>
  <% end %>
  <%= label if show_text %>
<% end %>

<% if as_link %>
  <%= link_to delete_path,
      class: "#{classes} block cursor-pointer transition-colors",
      title: tooltip,
      data: data.merge(turbo_method: :delete) do
  %>
    <%= content %>
  <% end %>
  <div>
  </div>
<% else %>
  <%= button_to delete_path,
      method: :delete,
      class: "#{classes} cursor-pointer transition-colors",
      title: tooltip,
      data: data do
  %>
    <%= content %>
  <% end %>
<% end %>