<% id ||= "card" %>
<% width ||= "w-full" %>
<% classes ||= "" %>
<% header_classes ||= "" %>
<% body_classes ||= "" %>
<% title ||= nil %>
<% header_content ||= nil %>
<% menu ||= nil %>
<% menu_icon ||= "fa-solid fa-ellipsis-vertical" %>

<div id="<%= id %>" class="card <%= width %> <%= classes %>">
  <% if title %>
    <div class="card-header <%= header_classes %>">
      <div class="card-title justify-between">
        <!-- Title -->
        <%= title %>

        <!-- Date and menu -->
        <% if header_content || menu %>
          <span>
            <%= header_content %>

            <% if menu %>
              <button
                type="button"
                class="btn btn-flush px-2 hover:text-gray-700"
                data-controller="dropdown"
                data-action="click->dropdown#toggle blur->dropdown#handleBlur"
              >
                <i class="<%= menu_icon %>"></i>
              </button>
              <ul class="dropdown-menu">
                <% menu.each do |menu_item| %>
                  <li>
                    <%= link_to menu_item[:label],
                      menu_item[:link],
                      class: "dropdown-item #{menu_item[:classes] || ""}",
                      data: menu_item[:data]
                    %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </span>
        <% end %>
      </div>
    </div>
  <% end %>
  <div class="card-body <%= body_classes %>">
    <%= yield %>
  </div>
</div>
