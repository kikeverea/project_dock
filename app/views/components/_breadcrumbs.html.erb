<div class="flex flex-wrap items-center gap-1">
  <%= link_to :back,
    class: "inline-flex mb-1 h-9 w-9 text-lg items-center justify-center rounded-lg hover:bg-gray-100" do
  %>
    ←
  <% end %>
  <ul class="flex items-center gap-2">
    <% crumbs.each do |crumb| %>
      <% path = Rails.application.routes.url_helpers.polymorphic_path(crumb) %>

      <li>
        <%= link_to crumb.model_name.human(count: 2), path, class: "hover:text-gray-700" %>
      </li>
      <li>/</li>
    <% end %>
    <li class="text-gray-500">
      Detalle
    </li>
  </ul>
</div>