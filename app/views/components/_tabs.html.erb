<% add_new ||= nil %>
<% classes ||= "" %>
<% query_param ||= :target %>
<% tab_style ||= :line %>
<% buttons ||= [] %>

<% tab_class = tab_style == :line ? "nav-line" : "nav-pill" %>

<div data-controller="tabs">
  <ul class="nav nav-tabs <%= classes %> <%= tab_class %>">
    <% tabs.each_with_index do |(attr, label), index| %>
      <% active = (index == 0 && params[query_param].nil?) || params[query_param] == attr.to_s %>

      <li class="nav-item">
        <a class="nav-link <%= "active" if active %>" data-action="click->tabs#switch" href="#<%= attr %>">
          <%= label %>
        </a>
      </li>
    <% end %>

    <% if buttons.any? %>
      <% buttons.each do |button| %>
        <%= link_to button[:link],
          class: "inline-block btn btn-link btn-muted btn-active-color-primary ps-0" do
        %>
          <i class="<%= button[:icon] %> origin-center hover:rotate-180 transition-transform duration-200 text-lg"></i>
        <% end %>
      <% end %>
    <% end %>

    <% if add_new %>
      <div class="flex-1 flex justify-end">
        <%= render "components/button_add_new",
          path: add_new[:path],
          label: add_new[:label]
        %>
      </div>
    <% end %>
  </ul>

  <div class="tab-content">
    <%= yield %>
  </div>
</div>