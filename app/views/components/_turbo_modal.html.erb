<% id ||= "#{channel}-modal" %>
<% size ||= "md" %>

<div id="<%= id %>" class="modal modal-<%= size %> fade" tabindex="-1">
  <div class="modal-dialog">
    <div id="<%= id %>-content" class="modal-content">

      <!-- Modal header -->
      <div class="flex items-center justify-between py-5 px-6 border-b border-gray-200">
        <h1 class="text-gray-700 m-0 text-lg font-semibold leading-6" id="<%= id %>-label">
          <%= title %>
        </h1>
        <button type="button" class="btn btn-flush btn-color-muted" data-bs-dismiss="modal" aria-label="Close">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <!-- Modal body -->
      <div id="<%= id %>-body" class="p-8">
        <div class="container-fluid">
          <div id="<%= id %>-outlet">
          </div>
        </div>
      </div>
    </div>
  </div>
</div>