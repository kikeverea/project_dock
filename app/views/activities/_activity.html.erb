<% activity ||= @activity %>
<% show_comments ||= false %>
<% tasks_completed = activity.tasks_completed? %>

<div id="activity-<%= activity.id %>" class="card w-[650px]">
  <div class="card-header <%= "bg-green-400 text-white" if tasks_completed %>">
    <div class="card-title justify-between">

      <div>
        <!-- Title -->
        <%= activity.name %>

        <%= link_to activity_generating_interaction_path(activity),
          class: "ms-2 #{tasks_completed ? "text-white hover:text-white" : "text-sky-700 hover:text-sky-800"}",
          data: { turbo_stream: true } do
        %>
          <i class="fa-solid fa-comments"></i>
        <% end %>
      </div>

      <!-- Date and menu -->
      <span>
        <span class="me-1 text-base">
          <%= activity.date&.strftime("%d-%m-%Y") || "Sin fecha" %>
        </span>
        <button
          type="button"
          class="btn btn-flush px-2 hover:text-gray-700"
          data-controller="dropdown"
          data-action="click->dropdown#toggle blur->dropdown#handleBlur"
        >
          <i class="fa-solid fa-ellipsis-vertical text-lg <%= tasks_completed ? "text-white" : "text-gray-500" %>"></i>
        </button>
        <ul class="dropdown-menu">
          <li>
            <%= link_to "Editar",
              edit_activity_path(activity), class: "dropdown-item",
              data: { turbo_stream: true }
            %>
          </li>
          <li>
            <%= link_to "Eliminar",
              activity,
              class: "dropdown-item",
              data: { controller: "delete-button", delete_button_item_name_value: activity.name }
            %>
          </li>
        </ul>
      </span>
    </div>
  </div>
  <div class="card-body pb-0" data-controller="expand">
    <%= render collection: activity.tasks.order(:order), partial: "tasks/task" %>

    <div class="flex justify-between items-center mt-2 ">
      <%= link_to new_activity_task_path(activity),
        class: "btn btn-link ps-0",
        data: { turbo_stream: true } do
      %>
        <i class="fa-solid fa-plus me-2"></i> Añadir tarea
      <% end %>
    </div>

    <div
      data-expand-target="content"
      class="<%= "hidden" unless show_comments %> mt-3 pt-3 border-t border-gray-200 text-sm text-gray-500"
    >
      <p>No hay comentarios todavía.</p>
    </div>
  </div>
</div>
