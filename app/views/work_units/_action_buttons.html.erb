<% unit ||= @work_unit %>
<% comments = unit.comments %>
<% has_comments = comments.any? %>

<div class="flex gap-2 justify-end items-center">
  <div class="hidden group-hover:flex gap-2">
    <!-- Delete -->
    <%= render "components/delete_button", delete_path: delete_path, no_padding: true, muted: true %>

    <!-- Edit -->
    <%= link_to edit_path, data: { turbo_stream: true } do %>
      <i class="fa-solid fa-pen hover:text-green-600 <%= has_comments ? "text-sky-700" : "text-gray-500" %>"></i>
    <% end %>
  </div>

  <!-- Comments -->
  <%= link_to comments_path,
    class: "cursor-pointer group-hover:inline #{"hidden" unless unit.comments.any?}",
    data: { turbo_prefetch: false, turbo_stream: true } do
  %>
    <i class="fa-solid fa-comment-dots text-xl hover:text-sky-800 <%= has_comments ? "text-sky-700" : "text-gray-500" %>"></i>
  <% end %>

  <!-- Toggle completed -->
  <% if unit.completable %>
    <% completed = unit.completed? %>
    <div class="form-check">
      <%= button_to unit,
        method: :put,
        params: {
          project_id: (@project.id unless @activity),
          activity_id: (@activity.id if @activity),
          unit.class.model_name.element => {
          completed_at: completed ? nil : Time.current,
          completed_by_id: completed ? nil : Current.user,
        }},
        class: "
          form-check-input relative h-[20px] w-[20px] rounded-full border border-2 cursor-pointer
          #{completed ? "bg-success border-green-500 opacity-75" : "border-gray-300"}
        " do
      %>
        <% if completed %>
          <i class="fa-solid fa-check text-white border-green-600 absolute top-[50%] left-[50%] -translate-[50%]"></i>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>