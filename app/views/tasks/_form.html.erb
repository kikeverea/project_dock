<% task ||= @task %>
<% activity ||= @activity %>

<%= modal_outlet(:task) do %>
  <%= render "components/error_banner", item: task %>

  <%= form_with model: [@project, @activity, task] do |form| %>

    <%= form.hidden_field :activity_id, value: activity.id %>

    <%= render "components/form_field",
      attribute: :title,
      item: task,
      form: form,
      icon: "fa-solid fa-user-group"
    %>

    <div class="mt-8 w-full text-end">
      <%= button_tag "Cancelar",
        type: :button,
        class: "btn btn-link btn-color-muted btn-active-color-success mx-4",
        data: { action: "modal#hide"}
      %>
      <%= form.button task.persisted? ? "Guardar" : "Crear tarea", class: "btn btn-success" %>
    </div>
  <% end %>
<% end %>
