<% task ||= @task %>

<% content_for :title, breadcrumbs(Project, @task.project, current: "Tarea", fallback: @task.project) %>

<div class="flex items-start justify-between gap-8 group">
  <%= render "components/editable_text",
    text: task.title,
    name: "task[title]",
    submit_path: task_path(task),
    row_char_count: "120",
    text_classes: "text-3xl font-semibold tracking-tight text-gray-900",
    classes: "flex-1"
  %>

  <div class="flex shrink-0 items-center gap-5">
    <span class="opacity-0 group-hover:opacity-100 transition-opacity duration-150">
      <span class="text-green-600">
        <%= task.completed? ? "Marcar no completada" : "Completar" %>
      </span>
      <i class="fas fa-arrow-right text-green-500 ms-2"></i>
    </span>
    <div class="form-check group">
      <% completed = task.completed_at.present? %>

      <%= button_to task,
        method: :put,
        params: { task: {
          completed_at: completed ? nil : Time.current,
          completed_by_id: completed ? nil : Current.user,
        }},
        class: "
          form-check-input relative rounded-full cursor-pointer h-[30px] w-[30px]
          border border-2 border-green-500
          #{task.completed? ? "bg-success hover:border-green-600" : ""}
        ",
        data: { controller: "tooltip" },
        form: {
          data: {
            turbo: false,
            turbo_drive: true
          }
        } do
      %>
        <i class="
          fa-solid fa-check absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2
          transition-opacity duration-150
          <%= task.pending? ? "opacity-0 text-green-500 group-hover:opacity-100" : "opacity-100 text-white" %>
        "></i>
      <% end %>
    </div>
  </div>
</div>

<%= task_status_badge(task) %>

<div class="flex flex-col xl:flex-row gap-8 py-8">
  <div class="xl:flex-2">
    <%= render "comments/timeline", new_path: new_task_comment_path(task), comments: task.comments %>
  </div>
  <div class="xl:flex-1">
    <%= render "components/card" do %>
      <%= render "components/simple_file_drop", upload_path: task_documents_path(task), classes: "h-40" %>
      <%= render "tasks/documents" %>
    <% end %>
  </div>
</div>

<%= render "components/turbo_modal", channel: :task, size: "md", title: "Tarea" %>
