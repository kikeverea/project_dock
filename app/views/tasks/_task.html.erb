<% task ||= @task %>

<%= render "components/card",
  id: "task-#{task.id}",
  width: "w-[450px] py-0", height: "h-fit",
  classes: "#{"bg-green-100" if task.completed?}" do
%>
  <div class="flex gap-6 py-2 group <%= task.completed? && "line-through text-success" %>">
    <div class="flex-1 break-all line-clamp-2">
      <%= task.title %>
    </div>

    <%= render "work_units/action_buttons",
      edit_path: edit_task_path(task),
      delete_path: task_path(task),
      comments_path: task_comments_path(task),
      unit: task
    %>
  </div>
<% end %>